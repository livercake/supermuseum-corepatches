+    int diag_dset_count = 0;    // MUSEUM FIX: telemetry - dset() calls since cart boot
+    int diag_pmem_count = 0;    // MUSEUM FIX: telemetry - pmem writes since cart boot
+    int diag_lastDsetAddr = -1; // MUSEUM FIX: telemetry - last dset slot
+    float diag_lastDsetVal = 0; // MUSEUM FIX: telemetry - last dset value
 
     void togglePauseMenu();
     bool IsPaused();
