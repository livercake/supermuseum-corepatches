 		for (int i = 0; i < 0x4000; i++)
 		{
@@ -385,6 +384,19 @@ void m2comm_device::comm_tick()
 				osd_file::open(m_remotehost, 0, m_line_tx, filesize);
 			}
 
+			// Emscripten fallback: real sockets can't be created here, so the
+			// socket handshake would never complete and the game would hang on
+			// "network checking".  In native MAME a lone cabinet self-connects
+			// (tx connects to its own listening rx); substitute a pipe pair
