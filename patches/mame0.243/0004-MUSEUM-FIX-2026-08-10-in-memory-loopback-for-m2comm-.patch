+		// sockets report connection loss.
+		if ((m_linkalive == 0x01) && !m_loopback_buf)
 		{
 			osd_printf_verbose("M2COMM: rx connection lost\n");
 			m_linkalive = 0x02;
diff --git a/src/mame/machine/m2comm.h b/src/mame/machine/m2comm.h
index 83821ba961..99b64d0ff2 100644
--- a/src/mame/machine/m2comm.h
+++ b/src/mame/machine/m2comm.h
@@ -9,10 +9,53 @@
 
 #include "osdfile.h"
 
+#include <algorithm>
+#include <vector>
+
 //**************************************************************************
 //  TYPE DEFINITIONS
 //**************************************************************************
 
+// In-memory loopback pipe.  Under Emscripten osd_file cannot create real
+// sockets, so the m2comm socket-based multi-cabinet handshake can never
+// complete and the game's network check hangs.  In native MAME a single
+// cabinet self-connects (tx connects to its own listening rx), so we
+// substitute a pipe pair sharing one buffer: data written via tx is
+// readable via rx, exactly like a loopback connection.
+class m2comm_pipe : public osd_file
+{
+public:
+	explicit m2comm_pipe(std::shared_ptr<std::vector<uint8_t>> buf) : m_buf(std::move(buf)) {}
+
+	// osd_file overrides
+	virtual std::error_condition read(void *buffer, std::uint64_t offset, std::uint32_t length, std::uint32_t &actual) noexcept override
+	{
+		actual = 0;
+		if (m_buf->empty())
+			return std::error_condition();
+
+		std::uint32_t n = std::min<std::uint32_t>(length, (std::uint32_t)m_buf->size());
+		memcpy(buffer, m_buf->data(), n);
+		m_buf->erase(m_buf->begin(), m_buf->begin() + n);
+		actual = n;
+		return std::error_condition();
+	}
+
+	virtual std::error_condition write(void const *buffer, std::uint64_t offset, std::uint32_t length, std::uint32_t &actual) noexcept override
+	{
+		uint8_t const *p = reinterpret_cast<uint8_t const *>(buffer);
+		m_buf->insert(m_buf->end(), p, p + length);
+		actual = length;
+		return std::error_condition();
+	}
+
+	virtual std::error_condition truncate(std::uint64_t offset) noexcept override { return std::error_condition(); }
+	virtual std::error_condition flush() noexcept override { return std::error_condition(); }
+
+private:
+	std::shared_ptr<std::vector<uint8_t>> m_buf;
+};
+
 class m2comm_device : public device_t
 {
 public:
@@ -73,6 +116,9 @@ private:
 	uint8_t m_linkcount = 0;
 	uint8_t m_zfg_delay = 0;
 
+	// shared loopback pipe buffer (Emscripten socket fallback)
+	std::shared_ptr<std::vector<uint8_t>> m_loopback_buf;
+
 	void comm_tick();
 	void read_fg();
 	int read_frame(int dataSize);
