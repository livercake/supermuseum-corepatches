+			if ((!m_line_rx || !m_line_tx) && !m_loopback_buf)
+			{
+				osd_printf_warning("M2COMM: sockets unavailable, using in-memory loopback\n");
+				m_loopback_buf = std::make_shared<std::vector<uint8_t>>();
+				m_line_rx = std::make_unique<m2comm_pipe>(m_loopback_buf);
+				m_line_tx = std::make_unique<m2comm_pipe>(m_loopback_buf);
+			}
+
 			// if both sockets are there check ring
 			if (m_line_rx && m_line_tx)
 			{
@@ -443,9 +455,9 @@ void m2comm_device::comm_tick()
 							send_frame(dataSize);
 						}
 
-						// consider it done
-						osd_printf_verbose("M2COMM: link established - id %02x of %02x\n", m_linkid, m_linkcount);
-						m_linkalive = 0x01;
+				// consider it done
+				osd_printf_warning("M2COMM: link established - id %02x of %02x\n", m_linkid, m_linkcount);
+				m_linkalive = 0x01;
 
