From b5f4ebe4ec69be2455bd7661a0647f592520766f Mon Sep 17 00:00:00 2001
From: Felipe Parada <livercake@gmail.com>
Date: Wed, 7 Oct 2026 21:56:27 -0300
Subject: [PATCH] MUSEUM FIX (2026-09-09): add Justifier input support to bsnes

bsnes's pollInputDevices() had a case for SuperScope but none for
Justifier/Justifiers, falling through to `default: return 0` -- so every
Justifier input was silently dropped. set_controller_ports connected the
device, but pollInputDevices never queried it. The source even carried a
`// TODO: SuperScope/Justifiers` comment.

program.cpp:
- defines RETRO_DEVICE_LIGHTGUN_JUSTIFIER / _JUSTIFIERS (program.cpp has
  its own lightgun macros; only SUPER_SCOPE existed)
- routes both through input_handle_touchscreen_lightgun
- maps Justifier trigger to mouse left button via POINTER_PRESSED
- Justifier input IDs differ from SuperScope: P1 = X0,Y1,Trigger2,Start3;
  chained P2 = X4,Y5,Trigger6,Start7

justifier.cpp:
- latch() now honors absolute/relative pointer mode
  (configuration.input.pointer.relative, mirroring the SuperScope path)
  instead of always accumulating, so the absolute mouse position lands
  correctly

Single-trigger Justifier: the museum maps aim (mouse) + shoot (left-click).
The second trigger and start are unmapped, acceptable for Lethal Enforcers P1.

Requires bsnes_touchscreen_lightgun = 'ON' in config.js -- it gates the
lightgun polling AND selects absolute pointer mode. Do not turn it off.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 bsnes/sfc/controller/justifier/justifier.cpp |  9 ++---
 bsnes/target-libretro/program.cpp            | 38 ++++++++++++++++++--
 2 files changed, 40 insertions(+), 7 deletions(-)

diff --git a/bsnes/sfc/controller/justifier/justifier.cpp b/bsnes/sfc/controller/justifier/justifier.cpp
index b8955a0..020d1c0 100644
--- a/bsnes/sfc/controller/justifier/justifier.cpp
+++ b/bsnes/sfc/controller/justifier/justifier.cpp
@@ -90,19 +90,20 @@ auto Justifier::latch(bool data) -> void {
 }
 
 auto Justifier::latch() -> void {
+  bool relativeMode = configuration.input.pointer.relative;
   if(!active) {
     int nx = platform->inputPoll(port, device, 0 + X);
     int ny = platform->inputPoll(port, device, 0 + Y);
-    player1.x = max(-16, min(256 + 16, nx + player1.x));
-    player1.y = max(-16, min((int)ppu.vdisp() + 16, ny + player1.y));
+    player1.x = max(-16, min(256 + 16, relativeMode ? nx + player1.x : nx));
+    player1.y = max(-16, min((int)ppu.vdisp() + 16, relativeMode ? ny + player1.y : ny));
     bool offscreen = (player1.x < 0 || player1.y < 0 || player1.x >= 256 || player1.y >= (int)ppu.vdisp());
     if(!offscreen) ppu.latchCounters(player1.x, player1.y);
   }
   else {
     int nx = platform->inputPoll(port, device, 4 + X);
     int ny = platform->inputPoll(port, device, 4 + Y);
-    player2.x = max(-16, min(256 + 16, nx + player2.x));
-    player2.y = max(-16, min((int)ppu.vdisp() + 16, ny + player2.y));
+    player2.x = max(-16, min(256 + 16, relativeMode ? nx + player2.x : nx));
+    player2.y = max(-16, min((int)ppu.vdisp() + 16, relativeMode ? ny + player2.y : ny));
     bool offscreen = (player2.x < 0 || player2.y < 0 || player2.x >= 256 || player2.y >= (int)ppu.vdisp());
     if(!offscreen) ppu.latchCounters(player2.x, player2.y);
   }
diff --git a/bsnes/target-libretro/program.cpp b/bsnes/target-libretro/program.cpp
index dc9b4fe..4c74d87 100644
--- a/bsnes/target-libretro/program.cpp
+++ b/bsnes/target-libretro/program.cpp
@@ -30,6 +30,8 @@ extern retro_log_printf_t libretro_print;
 extern void audio_queue(int16_t left, int16_t right);
 
 #define RETRO_DEVICE_LIGHTGUN_SUPER_SCOPE  RETRO_DEVICE_SUBCLASS(RETRO_DEVICE_LIGHTGUN, 0)
+#define RETRO_DEVICE_LIGHTGUN_JUSTIFIER    RETRO_DEVICE_SUBCLASS(RETRO_DEVICE_LIGHTGUN, 1)
+#define RETRO_DEVICE_LIGHTGUN_JUSTIFIERS   RETRO_DEVICE_SUBCLASS(RETRO_DEVICE_LIGHTGUN, 2)
 
 static Emulator::Interface *emulator;
 struct Program;
@@ -150,6 +152,15 @@ static void input_update_pointer_lightgun( unsigned port, unsigned gun_device)
 					retro_pointer.superscope_turbo_pressed = turbo_pressed;
 					break;
 				}
+				case RETRO_DEVICE_LIGHTGUN_JUSTIFIER:
+				{
+					// Justifier: single trigger on the mouse (POINTER_PRESSED = left button).
+					// Start is left unmapped for the kiosk's single-button setup.
+					retro_pointer.superscope_trigger_pressed =
+						input_state(port, RETRO_DEVICE_POINTER, 0, RETRO_DEVICE_ID_POINTER_PRESSED);
+					retro_pointer.superscope_start_pressed = false;
+					break;
+				}
 				default:
 					break;
     }
@@ -158,6 +169,19 @@ static void input_update_pointer_lightgun( unsigned port, unsigned gun_device)
 static int input_handle_touchscreen_lightgun( unsigned port, unsigned gun_device, unsigned inputId)
 {
 	input_update_pointer_lightgun(port, gun_device);
+	// Justifier input IDs differ from SuperScope: P1 = X0,Y1,Trigger2,Start3;
+	// P2 (chained Justifiers) = X4,Y5,Trigger6,Start7.
+	if (gun_device == RETRO_DEVICE_LIGHTGUN_JUSTIFIER)
+	{
+		switch (inputId)
+		{
+			case 0: case 4: return retro_pointer.x;
+			case 1: case 5: return retro_pointer.y;
+			case 2: case 6: return retro_pointer.superscope_trigger_pressed ? 1 : 0;
+			case 3: case 7: return retro_pointer.superscope_start_pressed ? 1 : 0;
+			default: return 0; // Unknown input
+		}
+	}
 	switch (inputId)
 	{
 		case 0: // X
@@ -451,8 +475,6 @@ auto pollInputDevices(uint port, uint device, uint input) -> int16
 			libretro_id = joypad_mapping[input % 12];
 			break;
 
-		// TODO: SuperScope/Justifiers.
-		// Do we care? The v94 port hasn't hooked them up. :)
 		case SuperFamicom::ID::Device::SuperScope:
 		{
 			libretro_device = RETRO_DEVICE_LIGHTGUN_SUPER_SCOPE;
@@ -463,7 +485,17 @@ auto pollInputDevices(uint port, uint device, uint input) -> int16
 				return 0;
 			}
 		}
-		
+		case SuperFamicom::ID::Device::Justifier:
+		case SuperFamicom::ID::Device::Justifiers:
+		{
+			libretro_device = RETRO_DEVICE_LIGHTGUN_JUSTIFIER;
+			if (retro_pointer_enabled)
+			{
+				return input_handle_touchscreen_lightgun(libretro_port, libretro_device, input);
+			} else {
+				return 0;
+			}
+		}
 
 		default:
 			return 0;
-- 
